# Public Supabase project settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only OpenRouter settings. Never prefix this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=

# Optional: only required for live RLS integration tests.
SUPABASE_TEST_URL=
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
